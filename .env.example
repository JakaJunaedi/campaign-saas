# ==============================================================================
# Campaign SaaS — Local Development Environment Configuration (.env.example)
# Copy this file to .env or export variables to override default connection settings.
# ASP.NET Core maps "Parent__Child" directly to "Parent:Child" in IConfiguration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Port Configuration
# Use 'localhost' if accessing via host machine / WSL port forwarding.
# Use 'host.docker.internal' or specific WSL IP if running from inside separate containers.
# ------------------------------------------------------------------------------
DEV_HOST=localhost

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campaign_saas_dev
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=DevPassword123!
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=campaign_saas_dev;Username=saas_admin;Password=DevPassword123!"

# ------------------------------------------------------------------------------
# 3. Redis Cache
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
Redis__Configuration="localhost:6379"

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=RabbitDev123!
RabbitMQ__Host="localhost"
RabbitMQ__Port=5672
RabbitMQ__Username="rabbit_user"
RabbitMQ__Password="RabbitDev123!"

# ------------------------------------------------------------------------------
# 5. MinIO Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioDevPassword123!
MinIO__Endpoint="localhost:9000"
MinIO__AccessKey="minio_admin"
MinIO__SecretKey="MinioDevPassword123!"
MinIO__UseSSL=false

# ------------------------------------------------------------------------------
# 6. Camunda BPMN Engine
# ------------------------------------------------------------------------------
CAMUNDA_HOST=localhost
CAMUNDA_PORT=8088
Camunda__RestUri="http://localhost:8088/engine-rest"

# ------------------------------------------------------------------------------
# 7. jsreport PDF Engine
# ------------------------------------------------------------------------------
JSREPORT_HOST=localhost
JSREPORT_PORT=5488
JsReport__Uri="http://localhost:5488"

# ------------------------------------------------------------------------------
# 8. Angular Frontend API Target (for proxy.conf.mjs)
# ------------------------------------------------------------------------------
API_TARGET=http://localhost:5000
